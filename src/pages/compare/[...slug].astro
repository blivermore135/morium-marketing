---
// /compare (the hub) and /compare/morium-vs-<name>. One file so that the whole set can be left out of the build
// until the owner approves the facts (src/data/publish.ts): with compare unpublished, getStaticPaths is empty.
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { competitors, AS_OF, AS_OF_ISO } from "../../data/compare";
import { published } from "../../data/publish";
import { SIGNUP_URL } from "../../data/site";

export function getStaticPaths() {
	if (!published.compare) return [];
	return [
		{ params: { slug: undefined }, props: { competitor: null } },
		...competitors.map((c) => ({ params: { slug: `morium-vs-${c.slug}` }, props: { competitor: c } })),
	];
}

const { competitor } = Astro.props;
const ORIGIN = "https://www.morium.one";
const isHub = !competitor;

const title = isHub ? "Morium Compared: Urable, QuoteIQ, Jobber, Mobile Tech RX | Morium" : competitor.title;
const description = isHub
	? `Honest, sourced comparisons of Morium with Urable, QuoteIQ, Jobber, and Mobile Tech RX for mobile detailers. Prices checked ${AS_OF}.`
	: competitor.description;

const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Morium", item: `${ORIGIN}/` },
		{ "@type": "ListItem", position: 2, name: "Compare", item: `${ORIGIN}/compare` },
		...(competitor
			? [{ "@type": "ListItem", position: 3, name: `Morium vs ${competitor.name}`, item: `${ORIGIN}/compare/morium-vs-${competitor.slug}` }]
			: []),
	],
};
---

<Layout title={title} description={description} jsonLd={[breadcrumb]}>
	<Header />
	<main class="mx-auto max-w-5xl px-6 py-16 lg:px-8">
		{isHub ? (
			<>
				<Breadcrumb items={[{ name: "Home", href: "/" }, { name: "Compare" }]} />
				<h1 class="mt-6 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
					Morium compared with other detailing software
				</h1>
				<p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink/70">
					We built Morium, so we are not neutral. We tried to be fair anyway: every price below comes from the company's own page, with the date we checked it ({AS_OF}). Each page says where the other tool is stronger, and who should pick it instead of us.
				</p>
				<div class="mt-12 grid gap-6 sm:grid-cols-2">
					{competitors.map((c) => (
						<a href={`/compare/morium-vs-${c.slug}`} class="group rounded-2xl border border-line bg-mist p-7 transition-colors hover:border-accent-300">
							<h2 class="font-body text-xl font-bold text-ink">Morium vs {c.name}</h2>
							<p class="mt-3 text-base leading-relaxed text-ink/65">{c.whoTheyAre}</p>
							<span class="mt-4 inline-block text-sm font-semibold text-accent-600 group-hover:text-accent-700">Read the comparison →</span>
						</a>
					))}
				</div>
			</>
		) : (
			<>
				<Breadcrumb items={[{ name: "Home", href: "/" }, { name: "Compare", href: "/compare" }, { name: `Morium vs ${competitor.name}` }]} />
				<h1 class="mt-6 max-w-3xl font-display text-4xl leading-tight font-bold tracking-tight text-ink sm:text-5xl">{competitor.h1}</h1>
				<p class="mt-3 text-sm text-ink/50">Prices and features checked <time datetime={AS_OF_ISO}>{AS_OF}</time>.</p>
				<p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink/70">{competitor.lead}</p>
				<p class="mt-4 max-w-3xl text-sm leading-relaxed text-ink/55">
					Full disclosure: Morium is our product, and today it supports detailing businesses. {competitor.name}: {competitor.whoTheyAre}
				</p>

				<h2 class="mt-14 font-display text-3xl font-bold tracking-tight text-ink">At a glance</h2>
				<div class="mt-5 overflow-x-auto rounded-2xl border border-line">
					<table class="w-full min-w-[34rem] text-left text-sm">
						<thead class="bg-mist text-ink">
							<tr>
								<th class="px-4 py-3 font-semibold"></th>
								<th class="px-4 py-3 font-semibold">Morium</th>
								<th class="px-4 py-3 font-semibold">{competitor.name}</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							{competitor.glance.map((row) => (
								<tr>
									<th scope="row" class="px-4 py-3 align-top font-semibold text-ink">{row.label}</th>
									<td class="px-4 py-3 align-top text-ink/70">{row.morium}</td>
									<td class="px-4 py-3 align-top text-ink/70">{row.them}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>

				<div class="mt-14 grid gap-8 md:grid-cols-2">
					<section>
						<h2 class="font-display text-2xl font-bold tracking-tight text-ink">Where {competitor.name} is stronger</h2>
						<ul class="mt-4 space-y-3">
							{competitor.strongerThem.map((t) => (
								<li class="flex items-start gap-3 text-base leading-relaxed text-ink/70"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/40"></span>{t}</li>
							))}
						</ul>
					</section>
					<section>
						<h2 class="font-display text-2xl font-bold tracking-tight text-ink">Where Morium is stronger</h2>
						<ul class="mt-4 space-y-3">
							{competitor.strongerMorium.map((t) => (
								<li class="flex items-start gap-3 text-base leading-relaxed text-ink/70"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span>{t}</li>
							))}
						</ul>
					</section>
				</div>

				<div class="mt-14 grid gap-8 md:grid-cols-2">
					<section class="rounded-2xl border border-line bg-mist p-7">
						<h2 class="font-body text-lg font-bold text-ink">Choose {competitor.name} if you…</h2>
						<ul class="mt-4 space-y-3">
							{competitor.chooseThem.map((t) => (
								<li class="text-base leading-relaxed text-ink/70">{t}</li>
							))}
						</ul>
					</section>
					<section class="rounded-2xl border border-accent-300 bg-accent-50 p-7">
						<h2 class="font-body text-lg font-bold text-ink">Choose Morium if you…</h2>
						<ul class="mt-4 space-y-3">
							{competitor.chooseMorium.map((t) => (
								<li class="text-base leading-relaxed text-ink/70">{t}</li>
							))}
						</ul>
						<a href={SIGNUP_URL} class="mt-6 inline-block rounded-full bg-accent-500 px-6 py-3 text-sm font-semibold text-ink">Start free trial</a>
					</section>
				</div>

				<section class="mt-14">
					<h2 class="font-display text-2xl font-bold tracking-tight text-ink">Where these facts come from</h2>
					<p class="mt-3 text-sm text-ink/55">Read from the company's own pages on {AS_OF}. Prices change, so check the page before you decide.</p>
					<ul class="mt-4 divide-y divide-line border-t border-b border-line text-sm">
						{competitor.facts.map((fact) => (
							<li class="py-3">
								<span class="font-semibold text-ink">{fact.label}:</span>
								<span class="text-ink/70"> {fact.value}. </span>
								<a href={fact.source} rel="noopener noreferrer nofollow" target="_blank" class="break-all text-accent-600 hover:text-accent-700">{fact.source}</a>
							</li>
						))}
					</ul>
					{competitor.note && <p class="mt-4 text-sm leading-relaxed text-ink/60">{competitor.note}</p>}
					<p class="mt-4 text-sm text-ink/55">Spot something out of date? Email us and we will fix it.</p>
				</section>
			</>
		)}
	</main>
	<FinalCTA />
	<Footer />
</Layout>
