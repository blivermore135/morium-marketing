---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { helpArticles, getHelpArticle } from "../../data/help";
import { CONTACT_EMAIL } from "../../data/site";

// Topics group the articles. Add a topic here when there is more than one group of articles.
const topics = [
	{
		name: "Your own website",
		blurb: "Put Morium booking on the website you already have.",
		slugs: helpArticles.map((a) => a.slug),
	},
];
---

<Layout
	title="Help Center | Morium"
	description="Step-by-step help for Morium, the booking and invoicing app for mobile detailers. Start with adding booking to your own website."
>
	<Header />
	<main class="mx-auto max-w-5xl px-5 py-10 sm:px-6 sm:py-16 lg:px-8">
		<h1 class="font-display text-4xl leading-tight font-bold tracking-tight text-ink sm:text-5xl">Help Center</h1>
		<p class="mt-4 max-w-2xl text-base leading-relaxed text-ink/70 sm:text-lg">
			Short guides with numbered steps, so you can get things done without waiting on anyone.
		</p>

		<div class="mt-8 max-w-xl">
			<label for="help-search" class="text-sm font-semibold text-ink">Search the guides</label>
			<input
				id="help-search"
				type="search"
				placeholder="Try: wix, button, form"
				autocomplete="off"
				class="mt-2 block w-full rounded-full border border-line bg-paper px-5 py-3 text-base text-ink placeholder:text-ink/45 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-300"
			/>
			<p id="help-empty" class="mt-3 hidden text-sm text-ink/65">
				No guide matches that. Try one word, or email <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-accent-700">{CONTACT_EMAIL}</a>.
			</p>
		</div>

		<div class="mt-10 space-y-12" id="help-topics">
			{topics.map((topic) => (
				<section data-help-topic>
					<h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">{topic.name}</h2>
					<p class="mt-2 text-base text-ink/65">{topic.blurb}</p>
					<div class="mt-5 grid gap-4 sm:grid-cols-2">
						{topic.slugs.map((slug) => {
							const a = getHelpArticle(slug)!;
							return (
								<a
									href={`/help/${a.slug}`}
									data-help-card
									data-search={`${a.title} ${a.summary} ${a.keywords.join(" ")}`.toLowerCase()}
									class="rounded-2xl border border-line bg-mist p-5 transition-colors hover:border-accent-300"
								>
									<h3 class="font-body text-base font-bold text-ink">{a.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-ink/65">{a.summary}</p>
								</a>
							);
						})}
					</div>
				</section>
			))}
		</div>

		<p class="mt-14 text-sm text-ink/60">
			Can't find it? Email <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-accent-700 hover:text-accent-800">{CONTACT_EMAIL}</a>.
		</p>
	</main>
	<Footer />
</Layout>

<script>
	// Filters the cards as you type. Every word you type has to appear somewhere in a card's title, summary or keywords.
	function setup() {
		const input = document.getElementById("help-search") as HTMLInputElement | null;
		const empty = document.getElementById("help-empty");
		if (!input) return;
		const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-help-card]"));
		const topics = Array.from(document.querySelectorAll<HTMLElement>("[data-help-topic]"));
		input.addEventListener("input", () => {
			const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
			let shown = 0;
			for (const card of cards) {
				const hay = card.dataset.search ?? "";
				const match = words.every((w) => hay.includes(w));
				card.classList.toggle("hidden", !match);
				if (match) shown++;
			}
			for (const t of topics) t.classList.toggle("hidden", !t.querySelector("[data-help-card]:not(.hidden)"));
			empty?.classList.toggle("hidden", shown > 0);
		});
	}
	setup();
	document.addEventListener("astro:after-swap", setup);
</script>
