---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { helpArticles, getHelpArticle } from "../../data/help";
import { richText } from "../../lib/richText";
import { CONTACT_EMAIL } from "../../data/site";

export function getStaticPaths() {
	return helpArticles.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const article = getHelpArticle(slug!)!;
const ORIGIN = "https://www.morium.one";

const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Morium", item: `${ORIGIN}/` },
		{ "@type": "ListItem", position: 2, name: "Help", item: `${ORIGIN}/help` },
		{ "@type": "ListItem", position: 3, name: article.title, item: `${ORIGIN}/help/${article.slug}` },
	],
};
const related = article.related.map((s) => getHelpArticle(s)).filter(Boolean);
---

<Layout title={article.seoTitle} description={article.description} jsonLd={[breadcrumb]}>
	<Header />
	<main class="mx-auto max-w-3xl px-5 py-10 sm:px-6 sm:py-16 lg:px-8">
		<Breadcrumb items={[{ name: "Help", href: "/help" }, { name: article.title }]} />
		<h1 class="mt-5 font-display text-3xl leading-tight font-bold tracking-tight text-balance text-ink sm:text-5xl">
			{article.title}
		</h1>
		<p class="mt-4 text-base leading-relaxed text-ink/70 sm:text-lg" set:html={richText(article.lead)} />
		{article.lastChecked && (
			<p class="mt-3 inline-flex rounded-full border border-line bg-mist px-3 py-1 text-xs font-semibold text-ink/65">
				Last checked: {article.lastChecked}
			</p>
		)}

		<div class="mt-10 space-y-10">
			{article.sections.map((section) => (
				<section>
					<h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">{section.heading}</h2>
					{section.note && (
						<aside class="mt-4 rounded-2xl border border-accent-300 bg-accent-50 p-4 sm:p-5">
							<p class="text-sm font-bold text-ink">{section.note.title}</p>
							<p class="mt-1.5 text-sm leading-relaxed text-ink/75" set:html={richText(section.note.text)} />
						</aside>
					)}
					{section.steps && (
						<ol class="mt-4 space-y-3">
							{section.steps.map((step, i) => (
								<li class="flex items-start gap-3 text-base leading-relaxed text-ink/75">
									<span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-500 font-body text-xs font-bold text-ink">{i + 1}</span>
									<span set:html={richText(step)} />
								</li>
							))}
						</ol>
					)}
					{section.bullets && (
						<ul class="mt-4 space-y-3">
							{section.bullets.map((item) => (
								<li class="flex items-start gap-3 text-base leading-relaxed text-ink/75">
									<span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span>
									<span set:html={richText(item)} />
								</li>
							))}
						</ul>
					)}
					{section.paragraphs?.map((p) => (
						<p class="mt-4 text-base leading-relaxed text-ink/75" set:html={richText(p)} />
					))}
				</section>
			))}
		</div>

		{article.builderLinks && (
			<section class="mt-12 rounded-2xl border border-line bg-mist p-5">
				<h2 class="font-body text-base font-bold text-ink">The builder's own help pages</h2>
				<p class="mt-1 text-sm text-ink/65">Menus and plans change, so these are the official pages to check.</p>
				<ul class="mt-3 space-y-2">
					{article.builderLinks.map((l) => (
						<li>
							<a href={l.url} target="_blank" rel="noopener" class="text-sm font-semibold text-accent-700 underline decoration-accent-300 underline-offset-2 hover:text-accent-800">{l.label}</a>
						</li>
					))}
				</ul>
			</section>
		)}

		<section class="mt-14">
			<h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">Related articles</h2>
			<div class="mt-5 grid gap-4 sm:grid-cols-2">
				{related.map((r) => (
					<a href={`/help/${r!.slug}`} class="rounded-2xl border border-line bg-mist p-5 transition-colors hover:border-accent-300">
						<h3 class="font-body text-base font-bold text-ink">{r!.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-ink/65">{r!.summary}</p>
					</a>
				))}
			</div>
		</section>

		<p class="mt-12 text-sm text-ink/60">
			Still stuck? Email <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-accent-700 hover:text-accent-800">{CONTACT_EMAIL}</a>.
		</p>
	</main>
	<Footer />
</Layout>
