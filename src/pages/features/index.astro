---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { features } from "../../data/features";

const ORIGIN = "https://www.morium.one";
const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Morium", item: `${ORIGIN}/` },
		{ "@type": "ListItem", position: 2, name: "Features", item: `${ORIGIN}/features` },
	],
};
---

<Layout
	title="Features for Mobile Detailers | Morium"
	description="Google review requests, rebook reminders, online booking, invoices and card payments, customer history, and pricing by vehicle size. All in one app for mobile detailers."
	jsonLd={[breadcrumb]}
>
	<Header />
	<main class="mx-auto max-w-5xl px-6 py-16 lg:px-8">
		<Breadcrumb items={[{ name: "Home", href: "/" }, { name: "Features" }]} />
		<h1 class="mt-6 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			What Morium does for a mobile detailer
		</h1>
		<p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/70">
			Morium keeps your customers coming back and your bookings organized, so you can spend your day detailing. These are the parts you will use most.
		</p>

		<div class="mt-12 grid gap-6 sm:grid-cols-2">
			{features.map((f) => (
				<a href={`/features/${f.slug}`} class="group rounded-2xl border border-line bg-mist p-7 transition-colors hover:border-accent-300">
					<h2 class="font-body text-xl font-bold text-ink">{f.name}</h2>
					<p class="mt-3 text-base leading-relaxed text-ink/65">{f.summary}</p>
					<span class="mt-4 inline-block text-sm font-semibold text-accent-600 group-hover:text-accent-700">Read more →</span>
				</a>
			))}
		</div>
	</main>
	<FinalCTA />
	<Footer />
</Layout>
