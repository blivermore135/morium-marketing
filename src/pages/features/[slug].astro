---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ScreenshotFrame from "../../components/ScreenshotFrame.astro";
import { features, getFeature } from "../../data/features";
import { SIGNUP_URL } from "../../data/site";

export function getStaticPaths() {
	return features.map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const feature = getFeature(slug!)!;
const ORIGIN = "https://www.morium.one";

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: feature.faqs.map((faq) => ({
		"@type": "Question",
		name: faq.q,
		acceptedAnswer: { "@type": "Answer", text: faq.a },
	})),
};
const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Morium", item: `${ORIGIN}/` },
		{ "@type": "ListItem", position: 2, name: "Features", item: `${ORIGIN}/features` },
		{ "@type": "ListItem", position: 3, name: feature.name, item: `${ORIGIN}/features/${feature.slug}` },
	],
};
const related = feature.related.map((s) => getFeature(s)).filter(Boolean);
---

<Layout title={feature.title} description={feature.description} jsonLd={[breadcrumb, faqSchema]}>
	<Header />
	<main class="mx-auto max-w-5xl px-6 py-16 lg:px-8">
		<Breadcrumb items={[{ name: "Home", href: "/" }, { name: "Features", href: "/features" }, { name: feature.name }]} />
		<h1 class="mt-6 max-w-3xl font-display text-4xl leading-tight font-bold tracking-tight text-ink sm:text-5xl">
			{feature.h1}
		</h1>
		<p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink/70">{feature.lead}</p>
		<div class="mt-8 flex flex-wrap items-center gap-4">
			<a href={SIGNUP_URL} class="rounded-full bg-accent-500 px-7 py-3.5 text-base font-semibold text-ink shadow-[0_8px_24px_-6px_rgba(0,194,199,0.55)] transition-transform hover:scale-[1.03]">Start free trial</a>
			<span class="text-sm text-ink/50">14-day free trial. From $33/mo.</span>
		</div>

		<div class="mt-12">
			<ScreenshotFrame src={feature.images[0].light} alt={feature.images[0].alt} />
		</div>

		<div class="mt-14 space-y-12">
			{feature.sections.map((section) => (
				<section>
					<h2 class="font-display text-3xl font-bold tracking-tight text-ink">{section.heading}</h2>
					{section.body && <p class="mt-3 max-w-3xl text-base leading-relaxed text-ink/70">{section.body}</p>}
					{section.items && (
						<ul class="mt-4 max-w-3xl space-y-3">
							{section.items.map((item) => (
								<li class="flex items-start gap-3 text-base leading-relaxed text-ink/70">
									<span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span>
									{item}
								</li>
							))}
						</ul>
					)}
				</section>
			))}
		</div>

		<section class="mt-16">
			<h2 class="font-display text-3xl font-bold tracking-tight text-ink">Questions</h2>
			<div class="mt-6 divide-y divide-line border-t border-b border-line">
				{feature.faqs.map((faq) => (
					<details class="group py-5">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-body text-base font-bold text-ink">
							{faq.q}
							<span class="shrink-0 text-xl text-ink/40 transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink/65">{faq.a}</p>
					</details>
				))}
			</div>
		</section>

		{related.length > 0 && (
			<section class="mt-16">
				<h2 class="font-display text-3xl font-bold tracking-tight text-ink">More Morium features</h2>
				<div class="mt-6 grid gap-5 sm:grid-cols-3">
					{related.map((r) => (
						<a href={`/features/${r!.slug}`} class="rounded-2xl border border-line bg-mist p-5 transition-colors hover:border-accent-300">
							<h3 class="font-body text-base font-bold text-ink">{r!.name}</h3>
							<p class="mt-2 text-sm leading-relaxed text-ink/65">{r!.summary}</p>
						</a>
					))}
				</div>
			</section>
		)}
	</main>
	<FinalCTA />
	<Footer />
</Layout>
