---
import Layout from "../layouts/Layout.astro";
import { websiteAddOn } from "../data/pricing";
import { CONTACT_EMAIL, TURNSTILE_SITE_KEY, WAITLIST_ENDPOINT, contactMailto, waitlistMailto } from "../data/site";

const input =
	"mt-1.5 w-full rounded-lg border border-line bg-paper px-3.5 py-3 text-base text-ink focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-300 aria-[invalid=true]:border-red-600 aria-[invalid=true]:ring-2 aria-[invalid=true]:ring-red-200";
const label = "block text-sm font-semibold text-ink";
---

<Layout
	title="Join the Website Waitlist | Morium"
	description="Want a real website built for your business? Websites are coming soon. Join the waitlist and we'll reach out when they open up."
>
	<div class="mx-auto max-w-xl px-6 py-14 sm:py-20" data-waitlist-page data-endpoint={WAITLIST_ENDPOINT} data-site-key={TURNSTILE_SITE_KEY}>
		<a href="/#website" class="text-sm font-semibold text-accent-700 hover:text-accent-800">&larr; Back to Morium</a>
		<h1 class="mt-6 font-display text-4xl leading-[1.1] font-bold tracking-tight text-balance text-ink sm:text-5xl">Join the website waitlist</h1>
		<p class="mt-4 text-base leading-relaxed text-ink/70">
			We'll build you a real website with a gallery, your service areas, and your booking form. Websites aren't open yet.
			Leave your details and we'll reach out when they are.
		</p>
		<p class="mt-2 text-sm text-ink/60">Planned price: ${websiteAddOn.setupFee} one-time setup, then ${websiteAddOn.monthlyPrice}/mo.</p>

		<form class="mt-8 space-y-5" data-waitlist-form method="post" action={WAITLIST_ENDPOINT} novalidate>
			<div>
				<label for="wl-name" class={label}>Your name</label>
				<input id="wl-name" name="name" type="text" class={input} autocomplete="name" maxlength="100" required aria-describedby="wl-name-error" />
				<p id="wl-name-error" class="mt-1 hidden text-sm text-red-700" data-error-for="name"></p>
			</div>
			<div>
				<label for="wl-business" class={label}>Business name</label>
				<input id="wl-business" name="businessName" type="text" class={input} autocomplete="organization" maxlength="120" required aria-describedby="wl-business-error" />
				<p id="wl-business-error" class="mt-1 hidden text-sm text-red-700" data-error-for="businessName"></p>
			</div>
			<div>
				<label for="wl-email" class={label}>Email</label>
				<input id="wl-email" name="email" type="email" class={input} autocomplete="email" inputmode="email" maxlength="254" required aria-describedby="wl-email-error" />
				<p id="wl-email-error" class="mt-1 hidden text-sm text-red-700" data-error-for="email"></p>
			</div>
			<div>
				<label for="wl-phone" class={label}>Phone <span class="font-normal text-ink/60">(optional)</span></label>
				<input id="wl-phone" name="phone" type="tel" class={input} autocomplete="tel" inputmode="tel" maxlength="40" aria-describedby="wl-phone-error" />
				<p id="wl-phone-error" class="mt-1 hidden text-sm text-red-700" data-error-for="phone"></p>
			</div>

			<!-- The bot trap: off the screen, out of the tab order, hidden from screen readers. A person never sees it, so it
			     stays empty; a bot that fills every box gives itself away. -->
			<div class="absolute -left-[10000px] h-px w-px overflow-hidden" aria-hidden="true" data-waitlist-trap>
				<label for="wl-company-website">Leave this empty</label>
				<input id="wl-company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
			</div>

			<div>
				<div id="wl-turnstile" data-waitlist-turnstile></div>
				<p class="mt-1 hidden text-sm text-red-700" data-error-for="turnstile"></p>
			</div>

			<p class="hidden rounded-lg border border-red-200 bg-red-50 px-3.5 py-3 text-sm text-red-800" role="alert" data-waitlist-error></p>

			<button
				type="submit"
				class="w-full rounded-full bg-ink px-7 py-3.5 text-base font-semibold text-paper transition-transform hover:scale-[1.02] disabled:cursor-wait disabled:opacity-70 disabled:hover:scale-100"
				data-waitlist-submit
			>
				Join the waitlist
			</button>
			<p class="text-center text-xs leading-relaxed text-ink/60">
				We only use these details to contact you about the website add-on. See our <a href="/privacy" class="font-semibold text-accent-700 hover:text-accent-800">privacy policy</a>.
			</p>
			<p class="text-center text-xs leading-relaxed text-ink/60">
				Trouble with this form? Email <a href={contactMailto("Website waitlist")} class="font-semibold text-accent-700 hover:text-accent-800">{CONTACT_EMAIL}</a> and we'll add you.
			</p>
		</form>

		<noscript>
			<p class="mt-6 rounded-lg border border-line bg-mist px-3.5 py-3 text-sm text-ink/70">
				This form needs JavaScript. You can also join by emailing
				<a href={waitlistMailto("Website add-on")} class="font-semibold text-accent-700 hover:text-accent-800">{CONTACT_EMAIL}</a>.
			</p>
		</noscript>

		<div class="mt-8 hidden rounded-2xl border border-line bg-mist px-6 py-8 text-center focus:outline-none" role="status" data-waitlist-thanks tabindex="-1">
			<h2 class="font-display text-3xl font-bold tracking-tight text-ink">Thank you!</h2>
			<p class="mt-3 text-base leading-relaxed text-ink/70" data-waitlist-thanks-message></p>
			<a href="/" class="mt-6 inline-block text-sm font-semibold text-accent-700 hover:text-accent-800">Back to Morium &rarr;</a>
		</div>
	</div>
</Layout>

<script>
	import { checkWaitlistValues, submitWaitlist } from "../lib/waitlistForm";
	import type { WaitlistField } from "../lib/waitlistForm";

	const TURNSTILE_SCRIPT = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
	type TurnstileApi = { render: (el: HTMLElement, options: Record<string, unknown>) => string; reset: (id?: string) => void; remove: (id?: string) => void };
	const win = window as unknown as { turnstile?: TurnstileApi };

	const INPUT_ID: Record<string, string> = { name: "wl-name", businessName: "wl-business", email: "wl-email", phone: "wl-phone" };

	// Loads Cloudflare's script once, then calls back. Explicit rendering, so the box also appears after a page-to-page
	// navigation (the site swaps pages without a full reload).
	let turnstileLoading: Promise<void> | null = null;
	function loadTurnstile(): Promise<void> {
		if (win.turnstile) return Promise.resolve();
		turnstileLoading ??= new Promise<void>((resolve, reject) => {
			const script = document.createElement("script");
			script.src = TURNSTILE_SCRIPT;
			script.async = true;
			script.onload = () => resolve();
			script.onerror = () => {
				turnstileLoading = null;
				reject(new Error("turnstile failed to load"));
			};
			document.head.appendChild(script);
		});
		return turnstileLoading;
	}

	function init() {
		const page = document.querySelector<HTMLElement>("[data-waitlist-page]");
		const form = page?.querySelector<HTMLFormElement>("[data-waitlist-form]");
		if (!page || !form || form.dataset.ready === "1") return;
		form.dataset.ready = "1";

		const endpoint = page.dataset.endpoint || "";
		const siteKey = page.dataset.siteKey || "";
		const submit = form.querySelector<HTMLButtonElement>("[data-waitlist-submit]")!;
		const formError = form.querySelector<HTMLElement>("[data-waitlist-error]")!;
		const thanks = page.querySelector<HTMLElement>("[data-waitlist-thanks]")!;
		const thanksMessage = page.querySelector<HTMLElement>("[data-waitlist-thanks-message]")!;
		const box = form.querySelector<HTMLElement>("[data-waitlist-turnstile]")!;
		const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? "";

		let widgetId: string | undefined;
		let token = "";
		loadTurnstile()
			.then(() => {
				if (!win.turnstile || widgetId !== undefined) return;
				widgetId = win.turnstile.render(box, {
					sitekey: siteKey,
					theme: "auto",
					callback: (t: string) => (token = t),
					"expired-callback": () => (token = ""),
					"error-callback": () => {
						token = "";
						showFormError("The \"are you a person?\" box ran into a problem. Please refresh the page and try again, or email us and we'll add you.");
						return true;
					},
				});
			})
			.catch(() => showFormError("The \"are you a person?\" box didn't load. Please refresh the page, or email us and we'll add you."));

		function clearErrors() {
			formError.classList.add("hidden");
			formError.textContent = "";
			form!.querySelectorAll<HTMLElement>("[data-error-for]").forEach((p) => {
				p.classList.add("hidden");
				p.textContent = "";
			});
			form!.querySelectorAll<HTMLInputElement>("input[aria-invalid]").forEach((i) => i.removeAttribute("aria-invalid"));
		}
		function showFormError(message: string) {
			formError.textContent = message;
			formError.classList.remove("hidden");
		}
		// Says what is wrong under the box that has the problem, and puts the cursor there.
		function showError(message: string, field?: WaitlistField) {
			const slot = field ? form!.querySelector<HTMLElement>(`[data-error-for="${field}"]`) : null;
			if (!slot) return showFormError(message);
			slot.textContent = message;
			slot.classList.remove("hidden");
			const input = INPUT_ID[field as string] ? document.getElementById(INPUT_ID[field as string]) : null;
			if (input) {
				input.setAttribute("aria-invalid", "true");
				input.focus();
			}
		}

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			clearErrors();
			const values = { name: value("name"), businessName: value("businessName"), email: value("email"), phone: value("phone"), trap: value("company_website") };

			const checked = checkWaitlistValues(values);
			if (!checked.ok) return showError(checked.error, checked.field);

			submit.disabled = true;
			const idleLabel = submit.textContent;
			submit.textContent = "Joining...";
			const outcome = await submitWaitlist(endpoint, values, token);
			submit.disabled = false;
			submit.textContent = idleLabel;

			if (outcome.ok) {
				thanksMessage.textContent = outcome.message;
				form.classList.add("hidden");
				thanks.classList.remove("hidden");
				thanks.focus();
				return;
			}
			showError(outcome.error, outcome.field);
			// A Turnstile answer works once, so a refused try needs a fresh one.
			if (win.turnstile && widgetId !== undefined) {
				token = "";
				win.turnstile.reset(widgetId);
			}
		});
	}

	// The site swaps pages without a full reload, so start on every page load, not only the first.
	document.addEventListener("astro:page-load", init);
	init();
</script>
