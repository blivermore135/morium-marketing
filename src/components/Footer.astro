---
import { industries } from "../data/industries";

const columns = [
	{
		heading: "Product",
		links: [
			{ label: "Pricing", href: "/pricing" },
			{ label: "Website add-on", href: "/websites" },
			{ label: "About", href: "/about" },
		],
	},
	{
		heading: "Industries",
		links: industries.map((i) => ({ label: i.name, href: `/${i.slug}` })),
	},
	{
		heading: "Company",
		links: [
			{ label: "Contact", href: "/contact" },
			{ label: "Privacy", href: "/privacy" },
			{ label: "Terms", href: "/terms" },
		],
	},
];
---

<footer class="border-t border-line px-6 py-16 lg:px-8">
	<div class="mx-auto grid max-w-7xl gap-12 sm:grid-cols-2 lg:grid-cols-[1fr_repeat(3,auto)]">
		<div>
			<span class="font-display text-xl font-bold text-ink">Morium</span>
			<p class="mt-3 max-w-xs text-sm leading-relaxed text-ink/55">
				Booking, CRM, and customer retention for mobile service businesses.
			</p>
		</div>

		{columns.map((col) => (
			<div>
				<h4 class="text-xs font-semibold tracking-wide text-ink/40 uppercase">
					{col.heading}
				</h4>
				<ul class="mt-4 space-y-2.5">
					{col.links.map((link) => (
						<li>
							<a href={link.href} class="text-sm text-ink/65 hover:text-ink">
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		))}
	</div>

	<div class="mx-auto mt-14 max-w-7xl border-t border-line pt-6">
		<p class="text-xs text-ink/40">
			&copy; {new Date().getFullYear()} Morium. All rights reserved.
		</p>
	</div>
</footer>
