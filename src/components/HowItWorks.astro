---
const steps = [
	{ label: "Customer books", body: "Through your booking page. No back-and-forth texting." },
	{ label: "Job lands on the calendar", body: "It shows up as a request on your dashboard. You confirm it and it goes on your calendar." },
	{ label: "A review request is ready", body: "Morium writes it after you finish the job. It goes out automatically, or after you approve it. Your choice." },
	{ label: "A rebook reminder brings them back", body: "Morium writes it when it's about time for their next visit. It goes out automatically, or after you approve it. Your choice." },
];
---

<section class="bg-ink px-6 py-24 text-paper lg:px-8">
	<div class="mx-auto max-w-7xl">
		<span class="text-xs font-semibold tracking-wide text-accent-300 uppercase">
			How it works
		</span>
		<h2 class="mt-3 max-w-2xl font-display text-3xl font-bold tracking-tight sm:text-4xl">
			The loop that keeps your calendar full.
		</h2>

		<div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{steps.map((step, i) => (
				<div class="relative">
					<div class="flex items-center gap-3">
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-500 font-body text-sm font-bold text-ink">
							{i + 1}
						</span>
						{i < steps.length - 1 && (
							<span class="hidden h-px flex-1 bg-paper/15 lg:block" aria-hidden="true"></span>
						)}
					</div>
					<h3 class="mt-5 font-body text-lg font-bold">{step.label}</h3>
					<p class="mt-2 text-sm leading-relaxed text-paper/60">{step.body}</p>
				</div>
			))}
		</div>
	</div>
</section>
