---
import { industries } from "../data/industries";
import { SIGNUP_URL, waitlistMailto, contactMailto } from "../data/site";
---

<section class="bg-mist px-6 py-24 lg:px-8">
	<div class="mx-auto max-w-7xl">
		<div class="max-w-2xl">
			<span class="text-xs font-semibold tracking-wide text-accent-600 uppercase">
				Industries
			</span>
			<h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
				Detailing is live. More trades are on the way.
			</h2>
		</div>

		<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{industries.map((industry) => (
				<a
					href={
						industry.live
							? SIGNUP_URL
							: industry.isCatchAll
								? contactMailto("Waitlist: Other")
								: waitlistMailto(industry.name)
					}
					class={`group flex flex-col justify-between rounded-2xl border p-6 transition-shadow hover:shadow-lg ${
						industry.isCatchAll
							? "border-2 border-dashed border-accent-300 bg-accent-500/5"
							: "border-line bg-paper"
					}`}
				>
					<div>
						{industry.live ? (
							<span class="inline-flex items-center rounded-full bg-accent-500/15 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-accent-700 uppercase">
								Live
							</span>
						) : !industry.isCatchAll ? (
							<span class="inline-flex items-center rounded-full bg-ink/5 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-ink/50 uppercase">
								Coming soon
							</span>
						) : null}
						<h3 class="mt-3 font-body text-lg font-bold text-ink">
							{industry.name}
						</h3>
						<p class="mt-1.5 text-sm leading-relaxed text-ink/60">
							{industry.blurb}
						</p>
					</div>
					<span class="mt-6 text-sm font-semibold text-accent-600 group-hover:text-accent-700">
						{industry.live ? "Get started" : industry.isCatchAll ? "Tell us what you do" : "Join the waitlist"} →
					</span>
				</a>
			))}
		</div>
	</div>
</section>
