---
import { industries } from "../data/industries";
import { waitlistMailto, contactMailto } from "../data/site";

// Section 4.3 (Industries "Option A"): was six equal-weight cards — the
// same visual treatment for "live today" and "hasn't been built yet" framed
// Morium as a six-industry horizontal platform with detailing bolted on,
// the wrong position against detailing-only competitors. Collapsed to one
// quiet line: detailing named plainly as the live product, every other
// trade folded into a single sentence instead of a card each. Per-trade
// waitlist mailtos are kept (each trade still gets its own tracked
// subject line) — just as inline text links now, not buttons.
const comingSoon = industries.filter((i) => !i.live && !i.isCatchAll);
---

<section class="mx-auto max-w-3xl px-6 py-10 text-center lg:px-8">
	<p class="text-sm leading-relaxed text-ink/55">
		Built for mobile service businesses — <strong class="font-semibold text-ink/80">detailing is live today.</strong>{" "}
		{comingSoon.map((industry, i) => (
			<>
				<a href={waitlistMailto(industry.name)} class="font-semibold text-accent-700 hover:text-accent-600">
					{industry.name}
				</a>
				{i < comingSoon.length - 2 ? ", " : i === comingSoon.length - 2 ? ", and " : " "}
			</>
		))}
		are next — join a waitlist above, or{" "}
		<a href={contactMailto("Waitlist: Other")} class="font-semibold text-accent-700 hover:text-accent-600">
			tell us what you do
		</a>{" "}
		if it's something else.
	</p>
</section>
