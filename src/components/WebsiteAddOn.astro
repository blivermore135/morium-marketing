---
import { websiteAddOn, pricingTiers, CRM_ADDON_DISCOUNT } from "../data/pricing";
import { WEBSITE_BOOKING_URL, contactMailto } from "../data/site";

const cheapestCrmDiscounted = Math.round(Math.min(...pricingTiers.map((t) => t.monthlyPrice)) * (1 - CRM_ADDON_DISCOUNT));
---

<!-- Section 4.3: promoted from 7th-of-12 (a plain bordered panel identical
     in weight to every other section) to right after the Hero, with its own
     hero-tier treatment — this is the differentiated product ("five-plus
     detailing CRMs already do the booking half; nobody else builds the
     site"), not a footnote add-on. The Hero itself stays the self-serve
     CRM signup front door (see its own new "We also build you a real
     website →" line linking down here) — this section is where that promise
     gets made good on, not a replacement for it. -->
<section id="website" class="relative overflow-hidden px-6 py-24 lg:px-8">
	<div
		class="pointer-events-none absolute -top-24 left-[-8%] h-[30rem] w-[30rem] rounded-full bg-accent-300/30 blur-[110px]"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2">
		<div>
			<span class="text-xs font-semibold tracking-wide text-accent-600 uppercase">
				The part other detailing CRMs don't do
			</span>
			<h2 class="mt-4 font-display text-4xl leading-[1.1] font-bold tracking-tight text-ink sm:text-5xl">
				We'll build you a real website, too.
			</h2>
			<p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/70">
				A gallery, your service areas, and a booking form — a site customers actually
				find and book from, not just an admin panel. This is its own standalone offer;
				you don't need a CRM plan to get a real website built for you.
			</p>
			<p class="mt-4 max-w-xl text-base leading-relaxed text-ink/65">
				Want the booking-and-customer-management side too? Add any CRM plan for{" "}
				{CRM_ADDON_DISCOUNT * 100}% off (starting at ${cheapestCrmDiscounted}/mo) since
				it's already wired into the site we build you.
			</p>
			<p class="mt-6 font-body text-2xl font-bold text-ink">
				${websiteAddOn.setupFee} setup <span class="text-ink/40 font-body font-normal text-lg">+</span> ${websiteAddOn.monthlyPrice}/mo
			</p>
			<div class="mt-7 flex flex-wrap items-center gap-4">
				<a
					href={WEBSITE_BOOKING_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="rounded-full bg-ink px-7 py-3.5 text-base font-semibold text-paper transition-transform hover:scale-[1.03]"
				>
					Just get started →
				</a>
			</div>
			<p class="mt-4 text-sm text-ink/55">
				That books a real conversation — every build starts with actually talking
				through your business. Prefer email? Reach out at{" "}
				<a href={contactMailto("Website inquiry")} class="font-semibold text-accent-600 hover:text-accent-700">moriumcomp@gmail.com</a>.
			</p>
		</div>

		<div class="relative rounded-2xl border border-line bg-mist p-3 shadow-[0_20px_50px_-20px_rgba(0,40,45,0.2)]">
			<div class="flex items-center gap-1.5 px-2 pb-3 pt-1">
				<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
				<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
				<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
			</div>
			<div class="aspect-video w-full overflow-hidden rounded-xl border border-ink/10">
				<img
					src="/images/coastal-detailing-preview.jpg"
					alt="Coastal Auto Detailing's real public website, built on Morium's website add-on"
					class="h-full w-full object-cover object-top"
				/>
			</div>
		</div>
	</div>
</section>
