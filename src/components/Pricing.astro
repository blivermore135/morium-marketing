---
import { pricingTiers, websiteAddOn } from "../data/pricing";
import { SIGNUP_URL } from "../data/site";

// Only tiers that are actually for sale (listed !== false in
// data/pricing.ts). Both Starter and Crew are listed as of 2026-09-30.
// 2026-09-27: the Monthly/Yearly toggle ("2 months free") is gone — checkout
// only ever sold monthly billing, so the yearly price was an advertised term
// nobody could actually buy. Annual billing comes back only as a real
// feature in bobsdetailing's checkout, not as a display toggle.
const listedTiers = pricingTiers.filter((tier) => tier.listed !== false);
---

<section id="pricing" class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
	<div class="mx-auto max-w-2xl text-center">
		<span class="text-xs font-semibold tracking-wide text-accent-600 uppercase">
			Pricing
		</span>
		<h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
			Simple pricing. No trial gimmicks.
		</h2>
		<p class="mt-4 text-base leading-relaxed text-ink/60">
			Every plan starts with a 14-day free trial. Billed monthly.
		</p>
	</div>

	<div
		class:list={[
			"mx-auto mt-12 grid gap-8",
			listedTiers.length > 1 ? "max-w-3xl sm:grid-cols-2" : "max-w-md",
		]}
	>
		{listedTiers.map((tier) => (
			<div
				class:list={[
					"relative rounded-2xl border p-8",
					tier.mostPopular
						? "border-accent-500 bg-paper shadow-[0_20px_50px_-20px_rgba(0,194,199,0.4)]"
						: "border-line bg-paper",
				]}
			>
				{tier.mostPopular && (
					<span class="absolute -top-3 left-8 rounded-full bg-accent-500 px-3 py-1 text-[11px] font-bold tracking-wide text-ink uppercase">
						Most popular
					</span>
				)}
				<h3 class="font-body text-lg font-bold text-ink">{tier.name}</h3>

				<p class="mt-4">
					<span class="font-display text-4xl font-bold text-ink">${tier.monthlyPrice}</span>
					<span class="text-sm font-medium text-ink/50">/mo</span>
				</p>

				<ul class="mt-6 space-y-3">
					{tier.features.map((feature) => (
						<li class="flex items-start gap-2.5 text-sm text-ink/70">
							<span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span>
							{feature}
						</li>
					))}
				</ul>

				<a
					href={SIGNUP_URL}
					class:list={[
						"mt-8 block rounded-full px-6 py-3 text-center text-sm font-semibold transition-transform hover:scale-[1.02]",
						tier.mostPopular ? "bg-accent-500 text-ink" : "border border-ink/15 text-ink",
					]}
				>
					Get started
				</a>
			</div>
		))}
	</div>

	<p class="mt-10 text-center text-sm text-ink/55">
		Want a real website too? Add it to any plan for a ${websiteAddOn.setupFee} one-time setup
		fee plus ${websiteAddOn.monthlyPrice}/mo.
		<a href="#website" class="font-semibold text-accent-600 hover:text-accent-700">See how it works →</a>
	</p>
</section>
