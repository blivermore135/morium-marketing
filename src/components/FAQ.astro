---
import { faqs } from "../data/faqs";
---

<section class="mx-auto max-w-3xl px-6 py-24 lg:px-8">
	<h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
		Questions, answered plainly.
	</h2>

	<div class="mt-10 divide-y divide-line border-t border-b border-line">
		{faqs.map((faq) => (
			<details class="group py-5">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-body text-base font-bold text-ink">
					{faq.q}
					<span class="shrink-0 text-xl text-ink/40 transition-transform group-open:rotate-45">
						+
					</span>
				</summary>
				<p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink/65">
					{faq.a}
				</p>
			</details>
		))}
	</div>
</section>
