---
import { SIGNUP_URL, SETUP_CALL_URL } from "../data/site";

// Only things that work today. Step 3 matches the app's Settings, Website tab: a booking link, a "Book now" button and the
// booking form for the owner's own website.
const steps = [
	{ title: "Add your services and prices", body: "Tell Morium what you offer and what it costs, so customers pick from your real list." },
	{ title: "Connect Stripe to take card payments", body: "Link your Stripe account so customers can pay an invoice by card." },
	{ title: "Share your booking link", body: "Send it to customers, or add it to the website you already have." },
];
---

<section id="get-started" class="px-6 py-20 sm:py-24 lg:px-8">
	<div class="mx-auto max-w-5xl">
		<span class="text-xs font-semibold tracking-wide text-accent-700 uppercase">Getting started</span>
		<h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Get started in 3 steps.</h2>

		<ol class="mt-10 grid gap-5 sm:grid-cols-3">
			{steps.map((step, i) => (
				<li class="rounded-2xl border border-line bg-mist p-5 sm:p-6">
					<span class="flex h-9 w-9 items-center justify-center rounded-full bg-accent-500 font-body text-sm font-bold text-ink">{i + 1}</span>
					<h3 class="mt-4 font-body text-lg font-bold text-ink">{step.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-ink/65">{step.body}</p>
				</li>
			))}
		</ol>

		<div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
			<a
				href={SIGNUP_URL}
				class="inline-flex h-11 items-center rounded-full bg-accent-500 px-7 text-base font-semibold text-ink shadow-[0_8px_24px_-6px_rgba(0,194,199,0.55)] transition-transform hover:scale-[1.03]"
			>
				Start free trial
			</a>
			<p class="text-base text-ink/70">
				Want help getting set up?{" "}
				<a href={SETUP_CALL_URL} target="_blank" rel="noopener" class="font-semibold text-accent-700 underline decoration-accent-300 underline-offset-2 hover:text-accent-800">Book a free setup call with Brock</a>.
			</p>
		</div>
	</div>
</section>
