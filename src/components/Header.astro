---
import { SIGNUP_URL, LOGIN_URL } from "../data/site";

const navLinks = [
	{ label: "Pricing", href: "/pricing" },
	{ label: "Detailing", href: "/detailing" },
	{ label: "Websites", href: "/websites" },
	{ label: "About", href: "/about" },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
		<a href="/" class="font-display text-xl font-bold tracking-tight text-ink">
			Morium
		</a>

		<nav class="hidden items-center gap-8 md:flex">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class="text-sm font-medium text-ink/70 transition-colors hover:text-ink"
				>
					{link.label}
				</a>
			))}
		</nav>

		<div class="flex items-center gap-3">
			<a
				href={LOGIN_URL}
				class="hidden text-sm font-semibold text-ink/80 hover:text-ink sm:block"
			>
				Log in
			</a>
			<a
				href={SIGNUP_URL}
				class="rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition-transform hover:scale-[1.03]"
			>
				Get started
			</a>
		</div>
	</div>
</header>
