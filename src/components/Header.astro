---
import { SIGNUP_URL, LOGIN_URL } from "../data/site";
import { published } from "../data/publish";

// Links work from every page (not just the home page). The compare and about pages are left out until published.
const navLinks = [
	{ label: "Features", href: "/features" },
	{ label: "Pricing", href: "/pricing" },
	...(published.compare ? [{ label: "Compare", href: "/compare" }] : []),
	{ label: "Websites", href: "/#website" },
	{ label: "About", href: published.about ? "/about" : "/#about" },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
		<a href="/" class="flex items-center gap-2 font-display text-xl font-bold tracking-tight text-ink">
			<img src="/images/morium-icon.png" alt="" class="h-8 w-auto" />
			Morium
		</a>

		<nav class="hidden items-center gap-8 md:flex">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class="text-sm font-medium text-ink/70 transition-colors hover:text-ink"
				>
					{link.label}
				</a>
			))}
		</nav>

		<div class="flex items-center gap-3 sm:gap-4">
			<a
				href={LOGIN_URL}
				class="text-sm font-semibold whitespace-nowrap text-ink/80 hover:text-ink"
			>
				Log in
			</a>
			<a
				href={SIGNUP_URL}
				class="rounded-full bg-ink px-4 py-2.5 text-sm font-semibold whitespace-nowrap text-paper transition-transform hover:scale-[1.03] sm:px-5"
			>
				Get started
			</a>
		</div>
	</div>
</header>
