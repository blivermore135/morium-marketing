---
import { SIGNUP_URL } from "../data/site";
---

<section class="relative overflow-hidden px-6 pt-6 pb-24 sm:pt-16 lg:px-8 lg:pt-24 lg:pb-32">
	<!-- vibrant background glow -->
	<div
		class="pointer-events-none absolute -top-32 right-[-10%] h-[36rem] w-[36rem] rounded-full bg-accent-300/40 blur-[110px]"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute -bottom-40 left-[-10%] h-[28rem] w-[28rem] rounded-full bg-accent-100/60 blur-[100px]"
		aria-hidden="true"
	>
	</div>

	<div class="relative mx-auto grid max-w-7xl items-center gap-16 lg:grid-cols-[1fr_1.25fr]">
		<div class="hero-copy">
			<span
				class="inline-flex items-center rounded-full border border-accent-300 bg-accent-50 px-4 py-1.5 text-xs font-semibold tracking-wide whitespace-nowrap text-accent-700 uppercase"
			>
				<span class="sm:hidden">Booking, invoices, and reviews</span>
				<span class="hidden sm:inline">Booking, reviews, invoices, and payments in one place</span>
			</span>

			<!-- The teal bar is drawn under "book online" with its own box (.headline-mark) instead of hanging off the
			     text's line box, and the lines have room between them, so the bar can never reach the letters of the
			     line below. The last words stay together so no word is left alone. -->
			<h1 class="headline mt-5 font-display leading-[1.22] font-bold tracking-tight text-balance text-ink sm:mt-6 sm:leading-[1.15]">
				<span class="block whitespace-nowrap">Customers <span class="headline-mark">book online</span>.</span>
				<span class="block">You get paid <span class="whitespace-nowrap">and get reviewed.</span></span>
			</h1>

			<p class="mt-4 max-w-xl text-base leading-relaxed text-ink/70 sm:mt-6 sm:text-lg">
				Morium writes your Google review requests and rebook reminders, takes
				bookings online, and sends invoices. Built for mobile detailers.
			</p>

			<div class="mt-5 flex flex-col gap-2.5 sm:mt-9 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
				<a
					href={SIGNUP_URL}
					class="flex h-11 w-full items-center justify-center rounded-full bg-accent-500 px-7 text-base font-semibold text-ink shadow-[0_8px_24px_-6px_rgba(0,194,199,0.55)] transition-transform hover:scale-[1.03] sm:inline-flex sm:h-auto sm:w-auto sm:py-3.5"
				>
					Start free trial
				</a>
				<a
					href="/features"
					class="flex h-11 w-full items-center justify-center rounded-full border border-ink/15 px-7 text-base font-semibold text-ink transition-colors hover:border-ink/30 sm:inline-flex sm:h-auto sm:w-auto sm:py-3.5"
				>
					See how it works →
				</a>
			</div>
			<!-- On a phone each line stands alone, high enough on the screen that Safari's bottom bar never covers the
			     waitlist link. -->
			<p class="mt-3 text-center text-sm text-ink/60 sm:mt-4 sm:text-left">
				<span class="block sm:inline">14-day free trial</span>
				<span class="mx-1.5 hidden sm:inline">·</span>
				<a href="/waitlist" class="mt-1 block font-semibold text-accent-700 hover:text-accent-800 sm:mt-0 sm:inline">
					Websites are coming soon: join the waitlist →
				</a>
			</p>

			<!-- Phones only (the wide dashboard picture below is for bigger screens). A real capture of the Follow-ups tab
			     from the Coastal Auto Detailing demo business: made-up customers, nothing that isn't built. -->
			<figure class="mt-8 flex flex-col items-center sm:hidden">
				<div class="w-[72%] max-w-[17rem] overflow-hidden rounded-[2rem] border-[7px] border-ink bg-ink shadow-[0_30px_60px_-20px_rgba(0,40,45,0.35)]">
					<img
						src="/images/app-followups-phone.jpg"
						width="780"
						height="1520"
						alt="The Follow-ups tab in the Morium app on a phone: a ready-to-send review request for a customer, with a Send by choice of email or text"
						class="block aspect-[390/600] w-full object-cover object-top"
					/>
				</div>
				<figcaption class="mt-3 text-center text-xs text-ink/60">The Follow-ups tab, shown with a demo business.</figcaption>
			</figure>
		</div>

		<div class="relative">
			<div
				class="relative rounded-2xl border border-line bg-mist p-3 shadow-[0_30px_60px_-20px_rgba(0,40,45,0.25)]"
			>
				<div class="flex items-center gap-1.5 px-2 pb-3 pt-1">
					<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
				</div>
				<!-- Full, uncropped capture of the admin screenshot at this scroll
				     position (not a tight content-only crop) — aspect ratio (1600:741)
				     matches the source exactly so object-cover never has to trim any
				     edge. Frame 0 is the top of the page (nav, booking link, stat
				     tiles, and the start of Revenue by Month/Package); frame 1 is
				     scrolled down to show the rest of those charts plus Busiest Day
				     of the Week — same wheel/swipe pattern as the Follow-Ups tile in
				     the Features section below. -->
				<div id="hero-frame" class="relative aspect-[1600/741] w-full overflow-hidden rounded-xl border border-ink/10">
					<img
						src="/images/showcase-hero-revenue-dark.jpg"
						alt="The Morium bookings dashboard, showing revenue by month and by package"
						data-hero-mode="dark"
						data-hero-frame="0"
						class="absolute inset-0 block h-full w-full object-cover object-top"
					/>
					<img
						src="/images/showcase-hero-revenue-light.jpg"
						alt="The Morium bookings dashboard, showing revenue by month and by package (light mode)"
						data-hero-mode="light"
						data-hero-frame="0"
						class="absolute inset-0 hidden h-full w-full object-cover object-top"
					/>
					<img
						src="/images/showcase-hero-revenue-2-dark.jpg"
						alt="The Morium bookings dashboard, scrolled to show the rest of revenue by month, revenue by package, and busiest day of the week"
						data-hero-mode="dark"
						data-hero-frame="1"
						class="absolute inset-0 hidden h-full w-full object-cover object-top"
					/>
					<img
						src="/images/showcase-hero-revenue-2-light.jpg"
						alt="The Morium bookings dashboard, scrolled to show the rest of revenue by month, revenue by package, and busiest day of the week (light mode)"
						data-hero-mode="light"
						data-hero-frame="1"
						class="absolute inset-0 hidden h-full w-full object-cover object-top"
					/>
					<span
						id="hero-scroll-hint"
						class="hero-scroll-hint pointer-events-none absolute inset-x-0 bottom-3 flex justify-center"
					>
						<span class="hero-scroll-hint-badge whitespace-nowrap rounded-full bg-ink/80 px-3 py-1 text-[11px] font-semibold text-paper shadow-lg">
							Scroll for more ↓
						</span>
					</span>
				</div>
			</div>
			<div class="mt-3 flex justify-center gap-1.5" role="tablist" aria-label="Screenshot theme">
				<button
					type="button"
					data-hero-mode-btn="light"
					aria-pressed="false"
					class="hero-mode-btn rounded-full border border-line bg-paper px-3 py-1 font-body text-xs font-semibold text-ink/65 transition-colors hover:border-accent-300 hover:text-ink"
				>
					☀ Light mode
				</button>
				<button
					type="button"
					data-hero-mode-btn="dark"
					aria-pressed="true"
					class="hero-mode-btn is-active rounded-full border border-accent-500 bg-accent-500 px-3 py-1 font-body text-xs font-semibold text-ink transition-colors"
				>
					☾ Dark mode
				</button>
			</div>
			<div class="mt-2 flex justify-center">
				<button
					type="button"
					id="hero-frame-btn"
					class="rounded-full border border-line bg-paper px-3 py-1 font-body text-xs font-semibold text-ink/65 transition-colors hover:border-accent-300 hover:text-ink"
				>
					Show more ↓
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	const heroFrameEl = document.getElementById("hero-frame");
	const heroImgs = Array.from(document.querySelectorAll<HTMLImageElement>("[data-hero-mode]"));
	const heroModeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-hero-mode-btn]"));
	const heroFrameBtn = document.getElementById("hero-frame-btn");
	const heroScrollHint = document.getElementById("hero-scroll-hint");

	let heroMode = "dark";
	let heroFrame = 0;

	function updateHero() {
		heroImgs.forEach((img) => {
			const show = img.dataset.heroMode === heroMode && img.dataset.heroFrame === String(heroFrame);
			img.classList.toggle("hidden", !show);
			img.classList.toggle("block", show);
		});
		heroScrollHint?.classList.toggle("hidden", heroFrame !== 0);
		if (heroFrameBtn) heroFrameBtn.textContent = heroFrame === 0 ? "Show more ↓" : "↑ Back to top";
	}

	function setHeroMode(mode: string) {
		heroMode = mode;
		heroModeBtns.forEach((btn) => {
			const active = btn.dataset.heroModeBtn === mode;
			btn.classList.toggle("is-active", active);
			btn.classList.toggle("border-accent-500", active);
			btn.classList.toggle("bg-accent-500", active);
			btn.classList.toggle("text-ink", active);
			btn.classList.toggle("border-line", !active);
			btn.classList.toggle("bg-paper", !active);
			btn.classList.toggle("text-ink/65", !active);
			btn.setAttribute("aria-pressed", String(active));
		});
		updateHero();
	}

	function setHeroFrame(frame: number) {
		heroFrame = frame;
		updateHero();
	}

	heroModeBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			if (btn.dataset.heroModeBtn) setHeroMode(btn.dataset.heroModeBtn);
		});
	});

	heroFrameBtn?.addEventListener("click", () => setHeroFrame(heroFrame === 0 ? 1 : 0));

	// Wheel/swipe over the screenshot steps between the two frames, same
	// pattern as the Follow-Ups tile below — only intercepts the gesture (and
	// only preventDefault()s the page scroll) at the exact moment it would
	// change something, so visitors scrolling past the hero are never
	// trapped.
	const SCROLL_THRESHOLD = 12;
	let scrollLocked = false;
	function tryHeroScroll(deltaY: number) {
		if (scrollLocked) return false;
		if (deltaY > SCROLL_THRESHOLD && heroFrame < 1) {
			setHeroFrame(1);
		} else if (deltaY < -SCROLL_THRESHOLD && heroFrame > 0) {
			setHeroFrame(0);
		} else {
			return false;
		}
		scrollLocked = true;
		setTimeout(() => {
			scrollLocked = false;
		}, 400);
		return true;
	}

	if (heroFrameEl) {
		heroFrameEl.addEventListener(
			"wheel",
			(e) => {
				if (tryHeroScroll(e.deltaY)) e.preventDefault();
			},
			{ passive: false }
		);

		let touchStartY: number | null = null;
		heroFrameEl.addEventListener(
			"touchstart",
			(e) => {
				touchStartY = e.touches[0]?.clientY ?? null;
			},
			{ passive: true }
		);
		heroFrameEl.addEventListener(
			"touchmove",
			(e) => {
				if (touchStartY === null) return;
				const currentY = e.touches[0]?.clientY ?? touchStartY;
				const deltaY = touchStartY - currentY;
				if (tryHeroScroll(deltaY)) {
					e.preventDefault();
					touchStartY = currentY;
				}
			},
			{ passive: false }
		);
	}
</script>

<style>
	/* The text column is a size container, and the headline is sized from its width, so the first sentence
	   ("Customers book online.") always fills exactly one line and never leaves "Customers" alone. The number is how
	   many font-sizes wide that sentence is (7.75, measured), with a little to spare. */
	.hero-copy {
		container-type: inline-size;
	}
	.headline {
		font-size: min(3.75rem, calc(100cqw / 8.3));
	}
	/* "book online" with its teal underline. The bar has its own box: a hair under the letters, thin, and
	   behind them. The headline's line height leaves more than the bar's depth before the next line starts. */
	.headline-mark {
		position: relative;
		display: inline-block;
		white-space: nowrap;
		line-height: 1;
	}
	.headline-mark::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.06em;
		height: 0.09em;
		border-radius: 9999px;
		background: var(--color-accent-400);
		z-index: -1;
	}
	.hero-scroll-hint-badge {
		animation: hero-scroll-hint-fade 2.4s ease-in-out infinite;
	}
	@keyframes hero-scroll-hint-fade {
		0%, 100% { opacity: 0.55; transform: translateY(0); }
		50% { opacity: 0.9; transform: translateY(-3px); }
	}
</style>
