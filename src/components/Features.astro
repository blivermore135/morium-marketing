---
// Real screenshots (mid-2026) — the admin ones are from a throwaway seeded
// demo org ("Prestige Auto Detailing"), never Bob's Detailing's actual
// customer data (seed script deleted the org right after capture); the
// booking-page ones (light + dark) are Bob's Detailing's real public quote
// form, which is fine to show since it's already public. No "Home screen
// install" tab — a PWA install prompt is an interaction, not a static view,
// so there's no honest screenshot for it; it's covered in the FAQ instead.
//
// Only the booking-page feature has a light/imageLight pair right now (the
// admin screens were only ever captured in dark mode), so the light/dark
// toggle only renders for features that actually have both images —
// faking a second theme for the others would be showing something that
// doesn't exist.
//
// Screenshots are cropped to the frame's 1470:812 aspect ratio (trimming a
// scrollbar sliver off the right edge) but kept at native capture
// resolution rather than downscaled to it — the admin ones are 1488x812,
// the booking-page ones are ~1700x940. Downscaling with a manual resize
// softened text on the first pass, so the fix was to stop resizing:
// object-cover crops to fit the frame at display time and the browser's
// own downscaling beats a manual bicubic pass, with headroom left over for
// high-DPI screens. "Bigger" comes from layout (full width, tall
// viewport-relative height, no cropped sidebar competing for space) rather
// than stretching the images themselves.
const features = [
	{
		id: "booking",
		name: "Online booking page",
		benefit: "Customers book you directly — no back-and-forth texting.",
		note: "Also installs as an app for your customers — and if we build you a website, this same page lives right on it too, always synced to the one calendar.",
		image: "/images/showcase-booking-dark.jpg",
		imageLight: "/images/showcase-booking-light.jpg",
	},
	{
		id: "dashboard",
		name: "Bookings dashboard",
		benefit: "See what's pending, confirmed, and done at a glance.",
		image: "/images/showcase-dashboard.jpg",
	},
	{
		id: "calendar",
		name: "Calendar view",
		benefit: "Your whole week, laid out before you start it.",
		image: "/images/showcase-calendar.jpg",
	},
	{
		id: "customers",
		name: "Customer records",
		benefit: "Every vehicle, every visit, every dollar — remembered for you.",
		image: "/images/showcase-customers.jpg",
	},
	{
		id: "revenue",
		name: "Revenue reporting",
		benefit: "Know your best month, your best service, your busiest day.",
		image: "/images/showcase-revenue.jpg",
	},
	{
		id: "reviews",
		name: "Automatic review requests",
		benefit: "Every completed job asks for a Google review, without you lifting a finger.",
		image: "/images/showcase-reviews.jpg",
	},
	{
		id: "rebooking",
		name: "Rebooking reminders",
		benefit: "Past customers get nudged back before they forget you.",
		image: "/images/showcase-rebooking.jpg",
	},
];
---

<section id="features" class="py-24">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="max-w-2xl">
			<span class="text-xs font-semibold tracking-wide text-accent-600 uppercase">
				What you get
			</span>
			<h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
				Everything you need to run the calendar. Nothing you don't.
			</h2>
		</div>
	</div>

	<div id="feature-showcase" class="mx-auto mt-10 max-w-[1800px] px-4 lg:px-8">
		<div class="flex flex-wrap justify-center gap-2" role="tablist">
			{features.map((feature, i) => (
				<button
					type="button"
					data-tab={feature.id}
					data-benefit={feature.benefit}
					data-note={feature.note ?? ""}
					data-has-light={feature.imageLight ? "true" : "false"}
					aria-pressed={i === 0 ? "true" : "false"}
					class:list={[
						"feature-tab rounded-full border px-4 py-2 font-body text-sm font-semibold transition-colors",
						i === 0 ? "is-active border-accent-500 bg-accent-500 text-ink" : "border-line bg-paper text-ink/65 hover:border-accent-300 hover:text-ink",
					]}
				>
					{feature.name}
				</button>
			))}
		</div>

		<p id="feature-showcase-benefit" class="mx-auto mt-4 max-w-xl text-center text-base text-ink/60">
			{features[0].benefit}
		</p>

		<div
			id="feature-showcase-mode-toggle"
			class:list={["mt-5 flex justify-center gap-1.5", features[0].imageLight ? "" : "hidden"]}
			role="tablist"
			aria-label="Screenshot theme"
		>
			<button
				type="button"
				data-mode="light"
				aria-pressed="false"
				class="mode-toggle-btn rounded-full border border-line bg-paper px-3 py-1 font-body text-xs font-semibold text-ink/65 transition-colors hover:border-accent-300 hover:text-ink"
			>
				☀ Light mode
			</button>
			<button
				type="button"
				data-mode="dark"
				aria-pressed="true"
				class="mode-toggle-btn is-active rounded-full border border-accent-500 bg-accent-500 px-3 py-1 font-body text-xs font-semibold text-ink transition-colors"
			>
				☾ Dark mode
			</button>
		</div>

		<div class="relative mt-6">
			<div class="relative rounded-2xl border border-line bg-mist p-3 shadow-[0_40px_80px_-30px_rgba(0,40,45,0.3)]">
				<div class="flex items-center gap-1.5 px-2 pb-3 pt-1">
					<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
					<span class="ml-2 text-xs font-medium text-ink/35" id="feature-showcase-label">{features[0].name}</span>
				</div>
				<div class="feature-showcase-frame relative w-full overflow-hidden rounded-xl">
					{features.map((feature, i) => (
						<Fragment>
							<img
								src={feature.image}
								alt={feature.name}
								data-panel={feature.id}
								data-mode="dark"
								class:list={[
									"absolute inset-0 h-full w-full object-cover object-top",
									i === 0 ? "block" : "hidden",
								]}
							/>
							{feature.imageLight && (
								<img
									src={feature.imageLight}
									alt={`${feature.name} (light mode)`}
									data-panel={feature.id}
									data-mode="light"
									class="absolute inset-0 hidden h-full w-full object-cover object-top"
								/>
							)}
						</Fragment>
					))}
				</div>
			</div>
			<span
				id="feature-showcase-hint"
				class="pointer-events-none absolute -bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-ink px-3 py-1 text-[11px] font-semibold text-paper shadow-lg transition-opacity lg:hidden"
			>
				Tap to explore →
			</span>
		</div>

		<p
			id="feature-showcase-note"
			class:list={["mx-auto mt-6 max-w-xl text-center text-sm text-ink/50", features[0].note ? "" : "hidden"]}
		>
			{features[0].note}
		</p>
	</div>
</section>

<script>
	const root = document.getElementById("feature-showcase");
	const tabs = Array.from(root?.querySelectorAll<HTMLButtonElement>("[data-tab]") ?? []);
	const panels = Array.from(root?.querySelectorAll<HTMLImageElement>("[data-panel]") ?? []);
	const label = document.getElementById("feature-showcase-label");
	const benefit = document.getElementById("feature-showcase-benefit");
	const note = document.getElementById("feature-showcase-note");
	const hint = document.getElementById("feature-showcase-hint");
	const modeToggle = document.getElementById("feature-showcase-mode-toggle");
	const modeButtons = Array.from(modeToggle?.querySelectorAll<HTMLButtonElement>("[data-mode]") ?? []);

	let currentMode: "light" | "dark" = "dark";

	function updatePanels(id: string) {
		const activeTab = tabs.find((t) => t.dataset.tab === id);
		const hasLight = activeTab?.dataset.hasLight === "true";
		panels.forEach((panel) => {
			const isActiveFeature = panel.dataset.panel === id;
			const show = isActiveFeature && (!hasLight || panel.dataset.mode === currentMode);
			panel.classList.toggle("hidden", !show);
			panel.classList.toggle("block", show);
		});
	}

	function activate(id: string) {
		tabs.forEach((tab) => {
			const active = tab.dataset.tab === id;
			tab.classList.toggle("is-active", active);
			tab.classList.toggle("border-accent-500", active);
			tab.classList.toggle("bg-accent-500", active);
			tab.classList.toggle("text-ink", active);
			tab.classList.toggle("border-line", !active);
			tab.classList.toggle("bg-paper", !active);
			tab.classList.toggle("text-ink/65", !active);
			tab.setAttribute("aria-pressed", String(active));
			if (active) {
				if (label) label.textContent = tab.textContent?.trim() ?? "";
				if (benefit) benefit.textContent = tab.dataset.benefit ?? "";
				if (note) {
					const noteText = tab.dataset.note ?? "";
					note.textContent = noteText;
					note.classList.toggle("hidden", noteText === "");
				}
				modeToggle?.classList.toggle("hidden", tab.dataset.hasLight !== "true");
			}
		});
		updatePanels(id);
	}

	function setMode(mode: "light" | "dark") {
		currentMode = mode;
		modeButtons.forEach((btn) => {
			const active = btn.dataset.mode === mode;
			btn.classList.toggle("is-active", active);
			btn.classList.toggle("border-accent-500", active);
			btn.classList.toggle("bg-accent-500", active);
			btn.classList.toggle("text-ink", active);
			btn.classList.toggle("border-line", !active);
			btn.classList.toggle("bg-paper", !active);
			btn.classList.toggle("text-ink/65", !active);
			btn.setAttribute("aria-pressed", String(active));
		});
		const activeTab = tabs.find((t) => t.classList.contains("is-active"));
		if (activeTab?.dataset.tab) updatePanels(activeTab.dataset.tab);
	}

	let autoplay = setInterval(() => {
		const currentIndex = tabs.findIndex((t) => t.classList.contains("is-active"));
		const next = tabs[(currentIndex + 1) % tabs.length];
		if (next?.dataset.tab) activate(next.dataset.tab);
	}, 3500);

	function stopAutoplay() {
		clearInterval(autoplay);
		hint?.style.setProperty("opacity", "0");
	}

	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			stopAutoplay();
			if (tab.dataset.tab) activate(tab.dataset.tab);
		});
	});

	modeButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			stopAutoplay();
			if (btn.dataset.mode === "light" || btn.dataset.mode === "dark") setMode(btn.dataset.mode);
		});
	});
</script>

<style>
	/* Native screenshots are 1488x812 (~1.83:1) — height is viewport-driven
	   for the "almost full screen" feel the user asked for, width caps out
	   around native resolution via the section's own max-width so nothing
	   upscales past source quality and blurs. Scaled down in three steps
	   rather than one flat vh value, so a tall narrow phone viewport doesn't
	   end up with a cropped-to-nothing sliver of the screenshot. */
	.feature-showcase-frame {
		aspect-ratio: 1470 / 812;
		max-width: 100%;
		margin: 0 auto;
		height: min(42vh, 420px);
	}
	@media (min-width: 768px) {
		.feature-showcase-frame {
			height: min(62vh, 680px);
		}
	}
	@media (min-width: 1280px) {
		.feature-showcase-frame {
			height: min(78vh, 860px);
		}
	}
</style>
