---
const features = [
	{ name: "Online booking page", benefit: "Customers book you directly — no back-and-forth texting." },
	{ name: "Bookings dashboard", benefit: "See what's pending, confirmed, and done at a glance." },
	{ name: "Calendar view", benefit: "Your whole week, laid out before you start it." },
	{ name: "Customer records", benefit: "Every vehicle, every visit, every dollar — remembered for you." },
	{ name: "Revenue reporting", benefit: "Know your best month, your best service, your busiest day." },
	{ name: "Automatic review requests", benefit: "Every completed job asks for a Google review, without you lifting a finger." },
	{ name: "Rebooking reminders", benefit: "Past customers get nudged back before they forget you." },
	{ name: "Home screen install", benefit: "Feels like an app on your phone — no App Store required." },
];
---

<section class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
	<div class="max-w-2xl">
		<span class="text-xs font-semibold tracking-wide text-accent-600 uppercase">
			What you get
		</span>
		<h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
			Everything you need to run the calendar. Nothing you don't.
		</h2>
	</div>

	<div class="mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
		{features.map((feature) => (
			<div>
				<div class="flex aspect-[4/3] items-center justify-center rounded-xl border border-dashed border-ink/15 bg-mist">
					<p class="px-4 text-center text-xs font-medium text-ink/35">
						[SCREENSHOT: {feature.name.toLowerCase()}]
					</p>
				</div>
				<h3 class="mt-4 font-display text-base font-bold text-ink">
					{feature.name}
				</h3>
				<p class="mt-1.5 text-sm leading-relaxed text-ink/60">{feature.benefit}</p>
			</div>
		))}
	</div>
</section>
