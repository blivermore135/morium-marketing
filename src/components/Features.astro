---
// Real screenshots (mid-2026) — the admin ones are from a throwaway seeded
// demo org (named "Bob's Detailing" so the header matches, but a separate
// DB row with fictional customers), never Bob's Detailing's actual customer
// data (seed script deleted the org right after capture); the booking-page
// ones are Bob's Detailing's real public quote form, which is fine to show
// since it's already public.
//
// Tile names match the real admin tab labels (Overview/Bookings/Calendar/
// Customers/Follow-Ups) as closely as sounds good, so the tab bar drawn
// inside each screenshot lines up with what it's actually called — see the
// nav-hotspot overlay below. "Online Booking Page" is the exception since
// there's no admin tab for it (it's the customer-facing page, not an admin
// view).
//
// Order is deliberate: Follow-Ups leads because automatic review requests +
// rebooking nudges (with fully editable wording) is the thing most generic
// booking/scheduling tools don't do — Online Booking Page goes last because
// "customers can book online" is table stakes everywhere now, not a reason
// to pick this over anything else.
//
// Every tile that has both themes captured gets the light/dark toggle;
// tiles with only one capture just don't show the toggle.
//
// Follow-Ups is the one tile that scrolls, and the only one with more than
// one "kind" — real admin has a Follow-up type picker (Google Review /
// Next Detail), each with its own Awaiting Your Approval + Waiting Period +
// Recently Sent. Each kind here is a `states` entry carrying an ordered
// `frames` array (one screenshot per real scroll position, captured so
// consecutive frames pick up exactly where the previous one left off — no
// skipped content, no wasted blank space); wheel/swipe steps through those
// frames same as scrolling the actual admin page would. A state's `label`
// is what opts a feature into the kind-switcher pills; states without one
// (every other tile) just render their single frame with no picker.
//
// Screenshots are cropped to the frame's 1470:812 aspect ratio (trimming a
// scrollbar sliver off the right edge) but kept at native capture
// resolution rather than downscaled to it — object-cover crops to fit the
// frame at display time and the browser's own downscaling beats a manual
// resize pass, with headroom left over for high-DPI screens.
const features = [
	{
		id: "followups",
		name: "Follow-Ups",
		benefit: "Google reviews and rebooking nudges go out on their own — write the message once, then forget about it.",
		admin: true,
		states: [
			{
				id: "detail",
				label: "🚗 Next Detail Follow-Ups",
				frames: [
					{ image: "/images/showcase-followups-detail-1-dark.jpg", imageLight: "/images/showcase-followups-detail-1-light.jpg" },
					{ image: "/images/showcase-followups-detail-2-dark.jpg", imageLight: "/images/showcase-followups-detail-2-light.jpg" },
				],
			},
			{
				id: "google",
				label: "🌟 Google Review Follow-Ups",
				frames: [
					{ image: "/images/showcase-followups-google-1-dark.jpg", imageLight: "/images/showcase-followups-google-1-light.jpg" },
					{ image: "/images/showcase-followups-google-2-dark.jpg", imageLight: "/images/showcase-followups-google-2-light.jpg" },
					{ image: "/images/showcase-followups-google-3-dark.jpg", imageLight: "/images/showcase-followups-google-3-light.jpg" },
				],
			},
		],
		comingSoon: {
			label: "🤖 AI Calling & Messaging",
			hint: "Coming soon — the same automation, but a real call or text instead of just email.",
		},
	},
	{
		id: "revenue",
		name: "Overview",
		benefit: "Know your best month, your best service, your busiest day.",
		admin: true,
		states: [
			{ id: "default", image: "/images/showcase-revenue-dark.jpg", imageLight: "/images/showcase-revenue-light.jpg" },
		],
	},
	{
		id: "customers",
		name: "Customers",
		benefit: "Every vehicle, every visit, every dollar — remembered for you.",
		admin: true,
		states: [
			{
				id: "default",
				image: "/images/showcase-customers-dark.jpg",
				imageLight: "/images/showcase-customers-light.jpg",
			},
		],
	},
	{
		id: "calendar",
		name: "Calendar",
		benefit: "Your whole week, laid out before you start it.",
		admin: true,
		states: [
			{ id: "default", image: "/images/showcase-calendar-dark.jpg", imageLight: "/images/showcase-calendar-light.jpg" },
		],
	},
	{
		id: "dashboard",
		name: "Bookings",
		benefit: "See what's pending, confirmed, and done at a glance.",
		admin: true,
		states: [
			{ id: "expanded", image: "/images/showcase-dashboard-dark.jpg", imageLight: "/images/showcase-dashboard-light.jpg" },
		],
	},
	{
		id: "booking",
		name: "Online Booking Page",
		benefit: "Customers book you directly — no back-and-forth texting.",
		note: "Also installs as an app for your customers — and if we build you a website, this same page lives right on it too, always synced to the one calendar.",
		admin: false,
		states: [
			{ id: "default", image: "/images/showcase-booking-dark.jpg", imageLight: "/images/showcase-booking-light.jpg" },
		],
	},
];

// Every tile but Follow-Ups defines its one state as a plain image/imageLight
// pair rather than a `frames` array — wrap it here so the render loop and
// client script only ever have to deal with one shape (a list of frames).
for (const feature of features) {
	for (const state of feature.states) {
		if (!state.frames) state.frames = [{ image: state.image, imageLight: state.imageLight }];
	}
}

// Shared position of the admin nav bar baked into every admin screenshot —
// same header component, same spot in every capture. Approximate (eyeballed
// off the source images, padded for an easy click target, not pixel-exact).
// Only the tabs with a matching tile above get wired to actually switch;
// Invoices/Memberships/Settings show a "coming soon" hint instead since
// there's no screenshot for them yet.
const navHotspots = [
	{ label: "Overview", featureId: "revenue", left: "27%", width: "5.5%" },
	{ label: "Bookings", featureId: "dashboard", left: "32.5%", width: "6%" },
	{ label: "Calendar", featureId: "calendar", left: "38.5%", width: "5.5%" },
	{ label: "Customers", featureId: "customers", left: "44.8%", width: "5%" },
	{ label: "Follow-Ups", featureId: "followups", left: "49.8%", width: "5.4%" },
	{ label: "Invoices", featureId: null, left: "55.2%", width: "3.6%" },
	{ label: "Memberships", featureId: null, left: "58.8%", width: "6%" },
	{ label: "Settings", featureId: null, left: "64.8%", width: "5%" },
];
---

<section id="features" class="py-24">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="max-w-2xl">
			<span class="text-xs font-semibold tracking-wide text-accent-600 uppercase">
				What you get
			</span>
			<h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
				Everything you need to run the calendar. Nothing you don't.
			</h2>
		</div>
	</div>

	<div id="feature-showcase" class="mx-auto mt-10 max-w-[1800px] px-4 lg:px-8">
		<div class="flex flex-wrap justify-center gap-2" role="tablist">
			{features.map((feature, i) => (
				<button
					type="button"
					data-tab={feature.id}
					data-benefit={feature.benefit}
					data-note={feature.note ?? ""}
					data-admin={feature.admin ? "true" : "false"}
					aria-pressed={i === 0 ? "true" : "false"}
					class:list={[
						"feature-tab rounded-full border px-4 py-2 font-body text-sm font-semibold transition-colors",
						i === 0 ? "is-active border-accent-500 bg-accent-500 text-ink" : "border-line bg-paper text-ink/65 hover:border-accent-300 hover:text-ink",
					]}
				>
					{feature.name}
				</button>
			))}
		</div>

		<p id="feature-showcase-benefit" class="mx-auto mt-4 max-w-xl text-center text-base text-ink/60">
			{features[0].benefit}
		</p>

		<div
			id="feature-showcase-kind-toggle"
			class="mt-5 hidden justify-center gap-1.5"
			role="tablist"
			aria-label="Follow-up type"
		>
			{features.flatMap((feature) =>
				feature.states.length > 1
					? feature.states.map((state, si) => (
							<button
								type="button"
								data-kind-feature={feature.id}
								data-kind-state={state.id}
								aria-pressed={si === 0 ? "true" : "false"}
								class:list={[
									"kind-toggle-btn rounded-full border px-3 py-1 font-body text-xs font-semibold transition-colors",
									si === 0
										? "is-active border-accent-500 bg-accent-500 text-ink"
										: "border-line bg-paper text-ink/65 hover:border-accent-300 hover:text-ink",
								]}
							>
								{state.label}
							</button>
						))
					: []
			)}
		</div>

		<div
			id="feature-showcase-mode-toggle"
			class="mt-3 hidden justify-center gap-1.5"
			role="tablist"
			aria-label="Screenshot theme"
		>
			<button
				type="button"
				data-mode="light"
				aria-pressed="false"
				class="mode-toggle-btn rounded-full border border-line bg-paper px-3 py-1 font-body text-xs font-semibold text-ink/65 transition-colors hover:border-accent-300 hover:text-ink"
			>
				☀ Light mode
			</button>
			<button
				type="button"
				data-mode="dark"
				aria-pressed="true"
				class="mode-toggle-btn is-active rounded-full border border-accent-500 bg-accent-500 px-3 py-1 font-body text-xs font-semibold text-ink transition-colors"
			>
				☾ Dark mode
			</button>
		</div>

		<div class="relative mt-6">
			<div class="relative rounded-2xl border border-line bg-mist p-3 shadow-[0_40px_80px_-30px_rgba(0,40,45,0.3)]">
				<div class="flex items-center gap-1.5 px-2 pb-3 pt-1">
					<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
					<span class="ml-2 text-xs font-medium text-ink/35" id="feature-showcase-label">{features[0].name}</span>
				</div>
				<div class="feature-showcase-frame relative w-full overflow-hidden rounded-xl">
					{features.map((feature) =>
						feature.states.map((state, si) =>
							state.frames.map((frame, fi) => (
								<Fragment>
									<img
										src={frame.image}
										alt={`${feature.name}${state.id !== "default" ? ` — ${state.id}` : ""}${fi > 0 ? ` (scrolled ${fi})` : ""}`}
										data-panel={feature.id}
										data-state={state.id}
										data-frame={fi}
										data-mode="dark"
										class:list={[
											"absolute inset-0 h-full w-full object-cover object-top",
											feature.id === features[0].id && si === 0 && fi === 0 ? "block" : "hidden",
										]}
									/>
									{frame.imageLight && (
										<img
											src={frame.imageLight}
											alt={`${feature.name}${state.id !== "default" ? ` — ${state.id}` : ""}${fi > 0 ? ` (scrolled ${fi})` : ""} (light mode)`}
											data-panel={feature.id}
											data-state={state.id}
											data-frame={fi}
											data-mode="light"
											class="absolute inset-0 hidden h-full w-full object-cover object-top"
										/>
									)}
								</Fragment>
							))
						)
					)}

					<span
						id="feature-scroll-hint"
						class="scroll-hint pointer-events-none absolute inset-x-0 bottom-3 hidden justify-center"
					>
						<span class="scroll-hint-badge whitespace-nowrap rounded-full bg-ink/80 px-3 py-1 text-[11px] font-semibold text-paper shadow-lg">
							Scroll for more ↓
						</span>
					</span>

					{/* Nav-bar hotspots — clicking the tab names drawn inside the admin screenshots themselves switches tiles too, only live while an admin-view tile is showing */}
					<div id="feature-nav-hotspots" class="pointer-events-none absolute inset-0 hidden">
						{navHotspots.map((h) => (
							<button
								type="button"
								data-nav-hotspot={h.featureId ?? ""}
								data-nav-label={h.label}
								class="nav-hotspot pointer-events-auto absolute cursor-pointer"
								style={`top:9%;left:${h.left};width:${h.width};height:6%;`}
								aria-label={`Go to ${h.label}`}
							></button>
						))}
					</div>
					<span
						id="feature-nav-tooltip"
						class="pointer-events-none absolute hidden -translate-x-1/2 -translate-y-full rounded-md bg-ink px-2.5 py-1 text-[11px] font-semibold text-paper shadow-lg"
					>
						Coming soon
					</span>
				</div>
			</div>
			<span
				id="feature-showcase-hint"
				class="pointer-events-none absolute -bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-ink px-3 py-1 text-[11px] font-semibold text-paper shadow-lg transition-opacity lg:hidden"
			>
				Tap to explore →
			</span>
		</div>

		<div id="feature-showcase-coming-soon" class="mx-auto mt-5 hidden max-w-xl justify-center">
			<span
				class="coming-soon-chip relative inline-flex cursor-default items-center gap-1.5 rounded-full border border-dashed border-line px-3 py-1.5 font-body text-xs font-semibold text-ink/45"
			>
				<span id="feature-showcase-coming-soon-label"></span>
				<span class="coming-soon-tooltip pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-ink px-2.5 py-1 text-[11px] font-semibold text-paper opacity-0 shadow-lg transition-opacity">
					<span id="feature-showcase-coming-soon-hint"></span>
				</span>
			</span>
		</div>

		<p
			id="feature-showcase-note"
			class:list={["mx-auto mt-6 max-w-xl text-center text-sm text-ink/50", features[0].note ? "" : "hidden"]}
		>
			{features[0].note}
		</p>
	</div>
</section>

<script define:vars={{ featuresData: features.map((f) => ({ id: f.id, states: f.states.map((s) => ({ id: s.id, label: s.label ?? null, frameCount: s.frames.length })), comingSoon: f.comingSoon ?? null })) }}>
	const root = document.getElementById("feature-showcase");
	const tabs = Array.from(root?.querySelectorAll("[data-tab]") ?? []);
	const panels = Array.from(root?.querySelectorAll("[data-panel]") ?? []);
	const label = document.getElementById("feature-showcase-label");
	const benefit = document.getElementById("feature-showcase-benefit");
	const note = document.getElementById("feature-showcase-note");
	const hint = document.getElementById("feature-showcase-hint");
	const modeToggle = document.getElementById("feature-showcase-mode-toggle");
	const modeButtons = Array.from(modeToggle?.querySelectorAll("[data-mode]") ?? []);
	const kindToggle = document.getElementById("feature-showcase-kind-toggle");
	const kindButtons = Array.from(kindToggle?.querySelectorAll("[data-kind-state]") ?? []);
	const scrollHint = document.getElementById("feature-scroll-hint");
	const frame = document.querySelector(".feature-showcase-frame");
	const navHotspotLayer = document.getElementById("feature-nav-hotspots");
	const navHotspotBtns = Array.from(root?.querySelectorAll("[data-nav-hotspot]") ?? []);
	const navTooltip = document.getElementById("feature-nav-tooltip");
	const comingSoonWrap = document.getElementById("feature-showcase-coming-soon");
	const comingSoonLabel = document.getElementById("feature-showcase-coming-soon-label");
	const comingSoonHint = document.getElementById("feature-showcase-coming-soon-hint");

	const featureMap = new Map(featuresData.map((f) => [f.id, f]));

	let currentMode = "dark";
	const currentState = new Map(featuresData.map((f) => [f.id, f.states[0]]));
	const scrollFrame = new Map(featuresData.map((f) => [f.id, 0]));

	function updatePanels(featureId) {
		const feature = featureMap.get(featureId);
		const state = currentState.get(featureId) ?? feature?.states[0];
		const frameIndex = scrollFrame.get(featureId) ?? 0;
		panels.forEach((panel) => {
			const isActivePanel =
				panel.dataset.panel === featureId &&
				panel.dataset.state === state?.id &&
				Number(panel.dataset.frame) === frameIndex;
			const modeMatches = panel.dataset.mode === currentMode;
			const hasLightForThisFrame = panels.some(
				(p) =>
					p.dataset.panel === featureId &&
					p.dataset.state === state?.id &&
					Number(p.dataset.frame) === frameIndex &&
					p.dataset.mode === "light"
			);
			const show = isActivePanel && (modeMatches || (!hasLightForThisFrame && panel.dataset.mode === "dark"));
			panel.classList.toggle("hidden", !show);
			panel.classList.toggle("block", show);
		});
		const hasLight = panels.some(
			(p) =>
				p.dataset.panel === featureId &&
				p.dataset.state === state?.id &&
				Number(p.dataset.frame) === frameIndex &&
				p.dataset.mode === "light"
		);
		modeToggle?.classList.toggle("hidden", !hasLight);
		modeToggle?.classList.toggle("flex", hasLight);

		const hasKinds = Boolean(feature) && feature.states.length > 1;
		kindToggle?.classList.toggle("hidden", !hasKinds);
		kindToggle?.classList.toggle("flex", hasKinds);
		if (hasKinds) {
			kindButtons.forEach((btn) => {
				const active = btn.dataset.kindFeature === featureId && btn.dataset.kindState === state?.id;
				btn.classList.toggle("is-active", active);
				btn.classList.toggle("border-accent-500", active);
				btn.classList.toggle("bg-accent-500", active);
				btn.classList.toggle("text-ink", active);
				btn.classList.toggle("border-line", !active);
				btn.classList.toggle("bg-paper", !active);
				btn.classList.toggle("text-ink/65", !active);
				btn.setAttribute("aria-pressed", String(active));
			});
		}

		const showScrollHint = (state?.frameCount ?? 1) > 1 && frameIndex === 0;
		scrollHint?.classList.toggle("hidden", !showScrollHint);
		scrollHint?.classList.toggle("flex", showScrollHint);

		if (feature?.comingSoon && comingSoonWrap && comingSoonLabel && comingSoonHint) {
			comingSoonLabel.textContent = feature.comingSoon.label;
			comingSoonHint.textContent = feature.comingSoon.hint;
			comingSoonWrap.classList.remove("hidden");
			comingSoonWrap.classList.add("flex");
		} else {
			comingSoonWrap?.classList.add("hidden");
			comingSoonWrap?.classList.remove("flex");
		}
	}

	function activate(id) {
		tabs.forEach((tab) => {
			const active = tab.dataset.tab === id;
			tab.classList.toggle("is-active", active);
			tab.classList.toggle("border-accent-500", active);
			tab.classList.toggle("bg-accent-500", active);
			tab.classList.toggle("text-ink", active);
			tab.classList.toggle("border-line", !active);
			tab.classList.toggle("bg-paper", !active);
			tab.classList.toggle("text-ink/65", !active);
			tab.setAttribute("aria-pressed", String(active));
			if (active) {
				if (label) label.textContent = tab.textContent?.trim() ?? "";
				if (benefit) benefit.textContent = tab.dataset.benefit ?? "";
				if (note) {
					const noteText = tab.dataset.note ?? "";
					note.textContent = noteText;
					note.classList.toggle("hidden", noteText === "");
				}
				navHotspotLayer?.classList.toggle("hidden", tab.dataset.admin !== "true");
			}
		});
		// Reset to the tile's default kind/scroll position whenever we switch into it
		const feature = featureMap.get(id);
		if (feature) currentState.set(id, feature.states[0]);
		scrollFrame.set(id, 0);
		updatePanels(id);
	}

	function setMode(mode) {
		currentMode = mode;
		modeButtons.forEach((btn) => {
			const active = btn.dataset.mode === mode;
			btn.classList.toggle("is-active", active);
			btn.classList.toggle("border-accent-500", active);
			btn.classList.toggle("bg-accent-500", active);
			btn.classList.toggle("text-ink", active);
			btn.classList.toggle("border-line", !active);
			btn.classList.toggle("bg-paper", !active);
			btn.classList.toggle("text-ink/65", !active);
			btn.setAttribute("aria-pressed", String(active));
		});
		const activeTab = tabs.find((t) => t.classList.contains("is-active"));
		if (activeTab?.dataset.tab) updatePanels(activeTab.dataset.tab);
	}

	function setKind(featureId, stateId) {
		const feature = featureMap.get(featureId);
		const state = feature?.states.find((s) => s.id === stateId);
		if (!state || currentState.get(featureId)?.id === stateId) return;
		currentState.set(featureId, state);
		scrollFrame.set(featureId, 0);
		updatePanels(featureId);
	}

	let autoplay = setInterval(() => {
		const currentIndex = tabs.findIndex((t) => t.classList.contains("is-active"));
		const next = tabs[(currentIndex + 1) % tabs.length];
		if (next?.dataset.tab) activate(next.dataset.tab);
	}, 3500);

	function stopAutoplay() {
		clearInterval(autoplay);
		hint?.style.setProperty("opacity", "0");
	}

	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			stopAutoplay();
			if (tab.dataset.tab) activate(tab.dataset.tab);
		});
	});

	modeButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			stopAutoplay();
			if (btn.dataset.mode === "light" || btn.dataset.mode === "dark") setMode(btn.dataset.mode);
		});
	});

	kindButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			stopAutoplay();
			if (btn.dataset.kindFeature && btn.dataset.kindState) setKind(btn.dataset.kindFeature, btn.dataset.kindState);
		});
	});

	// Wheel/swipe over the frame steps through a tile's ordered screenshot
	// frames (currently only Follow-Ups has more than one). Only intercepts
	// the gesture — and only preventDefault()s the page scroll — at the exact
	// moment it would actually change something (advancing past the last
	// frame or back past the first falls through); everywhere else the
	// wheel/touch event passes through untouched so visitors are never
	// trapped unable to scroll the page.
	const SCROLL_THRESHOLD = 12;
	let scrollLocked = false;
	function tryScroll(featureId, deltaY) {
		const feature = featureMap.get(featureId);
		const state = currentState.get(featureId) ?? feature?.states[0];
		const frameCount = state?.frameCount ?? 1;
		if (frameCount <= 1 || scrollLocked) return false;
		const index = scrollFrame.get(featureId) ?? 0;
		if (deltaY > SCROLL_THRESHOLD && index < frameCount - 1) {
			scrollFrame.set(featureId, index + 1);
		} else if (deltaY < -SCROLL_THRESHOLD && index > 0) {
			scrollFrame.set(featureId, index - 1);
		} else {
			return false;
		}
		updatePanels(featureId);
		scrollLocked = true;
		setTimeout(() => {
			scrollLocked = false;
		}, 400);
		return true;
	}

	if (frame) {
		frame.addEventListener(
			"wheel",
			(e) => {
				const activeTab = tabs.find((t) => t.classList.contains("is-active"));
				const featureId = activeTab?.dataset.tab;
				if (featureId && tryScroll(featureId, e.deltaY)) {
					stopAutoplay();
					e.preventDefault();
				}
			},
			{ passive: false }
		);

		let touchStartY = null;
		frame.addEventListener(
			"touchstart",
			(e) => {
				touchStartY = e.touches[0]?.clientY ?? null;
			},
			{ passive: true }
		);
		frame.addEventListener(
			"touchmove",
			(e) => {
				if (touchStartY === null) return;
				const currentY = e.touches[0]?.clientY ?? touchStartY;
				const deltaY = touchStartY - currentY;
				const activeTab = tabs.find((t) => t.classList.contains("is-active"));
				const featureId = activeTab?.dataset.tab;
				if (featureId && tryScroll(featureId, deltaY)) {
					stopAutoplay();
					e.preventDefault();
					touchStartY = currentY;
				}
			},
			{ passive: false }
		);
	}

	navHotspotBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			const targetId = btn.dataset.navHotspot;
			if (targetId) {
				stopAutoplay();
				activate(targetId);
			} else if (navTooltip) {
				const rect = btn.getBoundingClientRect();
				const frameRect = btn.closest(".feature-showcase-frame")?.getBoundingClientRect();
				if (frameRect) {
					navTooltip.style.left = `${rect.left - frameRect.left + rect.width / 2}px`;
					navTooltip.style.top = `${rect.top - frameRect.top}px`;
					navTooltip.textContent = `${btn.dataset.navLabel} — coming soon`;
					navTooltip.classList.remove("hidden");
					setTimeout(() => navTooltip.classList.add("hidden"), 1600);
				}
			}
		});
	});

	activate(tabs[0]?.dataset.tab ?? "");
</script>

<style>
	/* Native screenshots are ~1470-1920 wide depending on capture — height is
	   viewport-driven for the "almost full screen" feel the user asked for,
	   scaled down in three steps rather than one flat vh value, so a tall
	   narrow phone viewport doesn't end up with a cropped-to-nothing sliver
	   of the screenshot.
	   Width is derived from that height (capped at the container) rather
	   than left to fill it, because `aspect-ratio` alone doesn't constrain
	   width on a plain block box — width resolves by filling the container
	   before aspect-ratio gets a say. Left alone, that mismatch let
	   object-fit: cover silently crop the screenshot by a viewport-dependent
	   amount, which is what was throwing off the in-image hotspot overlays. */
	.feature-showcase-frame {
		aspect-ratio: 1470 / 812;
		margin: 0 auto;
		height: min(42vh, 420px);
		width: min(100%, calc(min(42vh, 420px) * 1470 / 812));
	}
	@media (min-width: 768px) {
		.feature-showcase-frame {
			height: min(62vh, 680px);
			width: min(100%, calc(min(62vh, 680px) * 1470 / 812));
		}
	}
	@media (min-width: 1280px) {
		.feature-showcase-frame {
			height: min(78vh, 860px);
			width: min(100%, calc(min(78vh, 860px) * 1470 / 812));
		}
	}

	/* Discreet cue that a tile scrolls (Follow-Ups only) — a quiet fading
	   pill, not a bright CTA, since it's just a hint and the wheel/swipe
	   handler works whether or not anyone notices it. */
	.scroll-hint {
		display: none;
	}
	.scroll-hint.flex {
		display: flex;
	}
	.scroll-hint-badge {
		animation: scroll-hint-fade 2.4s ease-in-out infinite;
	}
	@keyframes scroll-hint-fade {
		0%, 100% { opacity: 0.55; transform: translateY(0); }
		50% { opacity: 0.9; transform: translateY(-3px); }
	}

	.coming-soon-chip:hover .coming-soon-tooltip,
	.coming-soon-chip:focus-visible .coming-soon-tooltip {
		opacity: 1;
	}

	#feature-showcase-coming-soon.flex {
		display: flex;
	}
</style>
